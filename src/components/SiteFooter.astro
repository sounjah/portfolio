---
interface Props {
  showContact?: boolean
}

const { showContact = false } = Astro.props

import mdocRaw from '../content/etusivu.mdoc?raw'
const fmMatch = mdocRaw.match(/^---\n([\s\S]*?)\n---/)
const fmRaw = fmMatch?.[1] ?? ''
const contactHeading: string = fmRaw.match(/^contactHeading:\s*(.+)$/m)?.[1]?.trim() ?? 'Contact'
const year = new Date().getFullYear()
---

<footer class="site-footer">
  {showContact && (
    <section class="contact" id="contact" aria-labelledby="contact-heading">
      <h2 class="contact__heading" id="contact-heading">{contactHeading}</h2>
      <a
        href="https://www.linkedin.com/in/sonjakujansuu/"
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn--primary"
      >
        <span class="btn__text">Connect with me on LinkedIn</span>
        <img src="/images/arrow.svg" class="btn__arrow" alt="" aria-hidden="true" width="27" height="15" />
      </a>
    </section>
  )}
  <p class="site-footer__copy">© Sonja Kujansuu {year}</p>
</footer>
