---
export const prerender = true

import BaseLayout from '../layouts/BaseLayout.astro'
import SiteHeader from '../components/SiteHeader.astro'
import SiteFooter from '../components/SiteFooter.astro'
import { getCollection } from 'astro:content'

// Luetaan etusivun CMS-data suoralla JSON-importilla (Vite bundlaa build-aikana).
// Tämä toimii Cloudflare Workers -ympäristössä toisin kuin @keystatic/core/reader,
// joka vaatii node:fs-moduulin. Keystatic kirjoittaa tiedostoon src/content/etusivu.json.
import etusivuData from '../content/etusivu.json'

const projektit = await getCollection('projektit')

const heroImage: string | undefined = etusivuData.heroImage ?? undefined
const heroImageAlt: string = etusivuData.heroImageAlt ?? 'Hero-kuva'
const introHeading: string = etusivuData.introHeading ?? 'Heippa! Tervetuloa Sonjan portfolioon.'
const introBody: string[] = etusivuData.introBody ?? []
const metaTitle: string = etusivuData.metaTitle ?? 'Sonja Kujansuu – Portfolio'
const metaDescription: string = etusivuData.metaDescription ?? 'Sonja Kujansuun UX- ja palvelumuotoilun portfolio'

// Hero-kuva: käytetään CMS:stä ladattua tai oletusta
const heroSrc = heroImage
  ?? 'https://images.unsplash.com/photo-1527199372136-dff50c10ea34?w=1400&q=80&auto=format&fit=crop'
---

<BaseLayout title={metaTitle} description={metaDescription}>
  <SiteHeader />

  <main>
    <!-- ── HERO ─────────────────────────────────────────── -->
    <section class="hero" aria-label="Herokuva">
      <img
        src={heroSrc}
        alt={heroImageAlt}
        class="hero__img"
      />
    </section>

    <!-- ── INTRO ─────────────────────────────────────────── -->
    <section class="intro" id="about">
      <h1 class="intro__heading">{introHeading}</h1>

      <div class="intro__body">
        {introBody?.map((kappale: string) => (
          <p>{kappale}</p>
        ))}
      </div>

      <a href="#tyot" class="intro__arrow" aria-label="Siirry töihin">↓</a>
    </section>

    <!-- ── NOSTOKORTTIEN GRID ─────────────────────────────── -->
    <section class="works" id="tyot" aria-labelledby="works-heading">
      <h2 class="sr-only" id="works-heading">Työt</h2>

      <div class="works__grid">
        {projektit.map((projekti) => {
          const coverSrc = projekti.data.coverImage
            ?? `https://images.unsplash.com/photo-1531297484001-80022131f5a1?w=700&q=80&auto=format&fit=crop`
          const tagDark = projekti.data.tag !== 'Jatkuva kehitys'

          return (
            <article class="card">
              <a href={`/tyot/${projekti.id}`} class="card__link" tabindex="-1" aria-hidden="true">
                <div class="card__img-wrap">
                  <img
                    src={coverSrc}
                    alt={projekti.data.title}
                    class="card__img"
                  />
                  <span class:list={['card__tag', { 'card__tag--dark': tagDark }]}>
                    {projekti.data.tag}
                  </span>
                </div>
              </a>
              <div class="card__body">
                <h3 class="card__title">
                  <a href={`/tyot/${projekti.id}`} class="card__title-link">
                    {projekti.data.title}
                  </a>
                </h3>
                <p class="card__desc">{projekti.data.ingress}</p>
                <a href={`/tyot/${projekti.id}`} class="btn btn--primary">
                  Lue lisää <span class="btn__arrow">→</span>
                </a>
              </div>
            </article>
          )
        })}
      </div>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>
