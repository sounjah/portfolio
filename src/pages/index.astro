---
export const prerender = true

import BaseLayout from '../layouts/BaseLayout.astro'
import SiteHeader from '../components/SiteHeader.astro'
import SiteFooter from '../components/SiteFooter.astro'
import { getCollection } from 'astro:content'
import mdocRaw from '../content/etusivu.mdoc?raw'

const projektitRaw = await getCollection('projektit')

// Parsitaan frontmatter yksinkertaisella regexillä
const fmMatch = mdocRaw.match(/^---\n([\s\S]*?)\n---/)
const fmRaw = fmMatch?.[1] ?? ''
const parseFm = (key: string) => fmRaw.match(new RegExp(`^${key}:\\s*(.+)$`, 'm'))?.[1]?.trim() ?? ''
const parseList = (key: string) => {
  const m = fmRaw.match(new RegExp(`${key}:\\n((?:  - .+\\n?)*)`, 'm'))
  return m ? m[1].trim().split('\n').map(r => r.replace(/^\s*- /, '').trim()) : []
}

// Sisältö (markdoc-teksti) on frontmatterin jälkeen
const introBodyRaw = mdocRaw.replace(/^---\n[\s\S]*?\n---\n*/, '').trim()

const jarjestys: string[] = parseList('projektiJarjestys')
const jarjestetyt = jarjestys
  .map((slug: string) => projektitRaw.find(p => p.id === slug))
  .filter(Boolean)
const loput = projektitRaw.filter(p => !jarjestys.includes(p.id))
const projektit = [...jarjestetyt, ...loput].filter(p => !p.data.hidden)

const heroImage: string = parseFm('heroImage')
const heroImageAlt: string = parseFm('heroImageAlt') || 'Sonja Kujansuu'
const introHeading: string = parseFm('introHeading') || 'Welcome to my portfolio!'
const introSubheading: string = parseFm('introSubheading') || ''
const metaTitle: string = parseFm('metaTitle') || 'Sonja Kujansuu – Portfolio'
const metaDescription: string = parseFm('metaDescription') || ''

const heroSrc = heroImage || '/images/heroImage.jpg'
---

<BaseLayout title={metaTitle} description={metaDescription}>
  <SiteHeader />

  <main>
    <!-- ── HERO ─────────────────────────────────────────── -->
    <section class="hero" id="about" aria-label="Esittely">
      <div class="hero__content">
        <h1 class="hero__heading">{introHeading}</h1>
        {introSubheading && (
          <p class="hero__subheading">{introSubheading}</p>
        )}
        <div class="hero__body">
          {introBodyRaw.split(/\n\n+/).filter(Boolean).map(p => (
            <p set:html={p.replace(/\n/g, '<br>')} />
          ))}
        </div>
        <a href="#tyot" class="hero__arrow" aria-label="Siirry töihin">↓</a>
      </div>
      <div class="hero__image-wrap">
        <img
          src={heroSrc}
          alt={heroImageAlt}
          class="hero__img"
        />
      </div>
    </section>

    <!-- ── NOSTOKORTTIEN GRID ─────────────────────────────── -->
    <section class="works" id="tyot" aria-labelledby="works-heading">
      <h2 class="sr-only" id="works-heading">Työt</h2>

      <div class="works__grid">
        {projektit.map((projekti) => {
          const coverSrc = projekti.data.coverImage
            ?? `https://images.unsplash.com/photo-1531297484001-80022131f5a1?w=700&q=80&auto=format&fit=crop`
          const tagDark = projekti.data.tag !== 'Continuous development'
          const cardOnly = projekti.data.cardOnly ?? false

          const CardTag = (
            <span class:list={['card__tag', { 'card__tag--dark': tagDark }]}>
              {projekti.data.tag}
            </span>
          )

          if (cardOnly) {
            return (
              <article class="card">
                <div class="card__img-wrap">
                  <img src={coverSrc} alt={projekti.data.title} class="card__img" />
                  {CardTag}
                </div>
                <div class="card__body">
                  <h3 class="card__title">{projekti.data.title}</h3>
                  {projekti.data.year && <p class="card__year">{projekti.data.year}</p>}
                  <p class="card__desc">{projekti.data.ingress}</p>
                </div>
              </article>
            )
          }

          return (
            <a href={`/tyot/${projekti.id}`} class="card">
              <div class="card__img-wrap">
                <img src={coverSrc} alt={projekti.data.title} class="card__img" />
                {CardTag}
              </div>
              <div class="card__body">
                <h3 class="card__title">{projekti.data.title}</h3>
                {projekti.data.year && <p class="card__year">{projekti.data.year}</p>}
                <p class="card__desc">{projekti.data.ingress}</p>
                <span class="btn btn--primary">
                  <span class="btn__text">Want to know more?</span>
                  <img src="/images/arrow.svg" class="btn__arrow" alt="" aria-hidden="true" width="27" height="15" />
                </span>
              </div>
            </a>
          )
        })}
      </div>
    </section>
  </main>

  <SiteFooter showContact={true} />
</BaseLayout>
