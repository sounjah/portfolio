---
export const prerender = true

import BaseLayout from '../layouts/BaseLayout.astro'
import SiteHeader from '../components/SiteHeader.astro'
import SiteFooter from '../components/SiteFooter.astro'
import { getCollection } from 'astro:content'

// Luetaan etusivun CMS-data suoralla JSON-importilla (Vite bundlaa build-aikana).
// Tämä toimii Cloudflare Workers -ympäristössä toisin kuin @keystatic/core/reader,
// joka vaatii node:fs-moduulin. Keystatic kirjoittaa tiedostoon src/content/etusivu.json.
import etusivuData from '../content/etusivu.json'

const projektitRaw = await getCollection('projektit')
const jarjestys: string[] = (etusivuData as any).projektiJarjestys ?? []
// Järjestetyt ensin, sitten loput (listaan lisäämättömät) perässä, piilotetut suodatetaan pois
const jarjestetyt = jarjestys
  .map(slug => projektitRaw.find(p => p.id === slug))
  .filter(Boolean)
const loput = projektitRaw.filter(p => !jarjestys.includes(p.id))
const projektit = [...jarjestetyt, ...loput].filter(p => !p.data.hidden)

const heroImage: string | undefined = (etusivuData as any).heroImage ?? undefined
const heroImageAlt: string = (etusivuData as any).heroImageAlt ?? 'Sonja Kujansuu'
const introHeading: string = (etusivuData as any).introHeading ?? 'Welcome to my portfolio!'
const introSubheading: string = (etusivuData as any).introSubheading ?? ''
const introBody: string[] = (etusivuData as any).introBody ?? []
const metaTitle: string = (etusivuData as any).metaTitle ?? 'Sonja Kujansuu – Portfolio'
const metaDescription: string = (etusivuData as any).metaDescription ?? 'Sonja Kujansuun UX- ja palvelumuotoilun portfolio'

const heroSrc = heroImage ?? '/images/heroImage.jpeg'
---

<BaseLayout title={metaTitle} description={metaDescription}>
  <SiteHeader />

  <main>
    <!-- ── HERO ─────────────────────────────────────────── -->
    <section class="hero" id="about" aria-label="Esittely">
      <div class="hero__content">
        <h1 class="hero__heading">{introHeading}</h1>
        {introSubheading && (
          <p class="hero__subheading">{introSubheading}</p>
        )}
        <div class="hero__body">
          {introBody?.map((kappale: string) => (
            <p>{kappale}</p>
          ))}
        </div>
        <a href="#tyot" class="hero__arrow" aria-label="Siirry töihin">↓</a>
      </div>
      <div class="hero__image-wrap">
        <img
          src={heroSrc}
          alt={heroImageAlt}
          class="hero__img"
        />
      </div>
    </section>

    <!-- ── NOSTOKORTTIEN GRID ─────────────────────────────── -->
    <section class="works" id="tyot" aria-labelledby="works-heading">
      <h2 class="sr-only" id="works-heading">Työt</h2>

      <div class="works__grid">
        {projektit.map((projekti) => {
          const coverSrc = projekti.data.coverImage
            ?? `https://images.unsplash.com/photo-1531297484001-80022131f5a1?w=700&q=80&auto=format&fit=crop`
          const tagDark = projekti.data.tag !== 'Jatkuva kehitys'
          const cardOnly = projekti.data.cardOnly ?? false

          const CardTag = (
            <span class:list={['card__tag', { 'card__tag--dark': tagDark }]}>
              {projekti.data.tag}
            </span>
          )

          if (cardOnly) {
            return (
              <article class="card">
                <div class="card__img-wrap">
                  <img src={coverSrc} alt={projekti.data.title} class="card__img" />
                  {CardTag}
                </div>
                <div class="card__body">
                  <h3 class="card__title">{projekti.data.title}</h3>
                  <p class="card__desc">{projekti.data.ingress}</p>
                </div>
              </article>
            )
          }

          return (
            <a href={`/tyot/${projekti.id}`} class="card">
              <div class="card__img-wrap">
                <img src={coverSrc} alt={projekti.data.title} class="card__img" />
                {CardTag}
              </div>
              <div class="card__body">
                <h3 class="card__title">{projekti.data.title}</h3>
                <p class="card__desc">{projekti.data.ingress}</p>
                <span class="btn btn--primary">
                  <span class="btn__text">Lue lisää</span>
                  <img src="/images/arrow.svg" class="btn__arrow" alt="" aria-hidden="true" width="27" height="15" />
                </span>
              </div>
            </a>
          )
        })}
      </div>
    </section>
  </main>

  <SiteFooter showContact={true} />
</BaseLayout>
