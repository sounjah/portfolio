---
import BaseLayout from '../../layouts/BaseLayout.astro'
import SiteHeader from '../../components/SiteHeader.astro'
import SiteFooter from '../../components/SiteFooter.astro'
import { getCollection, render } from 'astro:content'

export const prerender = true

export async function getStaticPaths() {
  const projektit = await getCollection('projektit')
  return projektit
    .filter((p) => !p.data.cardOnly)
    .map((p) => ({
      params: { slug: p.id },
      props: { projekti: p },
    }))
}

const { projekti } = Astro.props
const { Content } = await render(projekti)
const { title, year, tag, ingress, keywords, coverImage, projectUrl, projectUrlLabel } = projekti.data

const coverSrc = coverImage
  ?? 'https://images.unsplash.com/photo-1517694712202-14dd9538aa97?w=1200&q=80&auto=format&fit=crop'

const urlLabel = projectUrlLabel || 'Katso sivusto'
---

<BaseLayout title={`${title} – Sonja Kujansuu`} description={ingress}>
  <SiteHeader />

  <nav class="breadcrumb" aria-label="Navigaatio">
    <a href="/" class="breadcrumb__link">
      <span class="breadcrumb__arrow">←</span>
      Back
    </a>
  </nav>

  <main>
    <article class="project">
      <div class="project__grid">

        <!-- ── VASEN: kuva + tägit + painike (deskari) ─────── -->
        <div class="project__media">
          <img
            src={coverSrc}
            alt={title}
            class="project__cover"
          />
          {keywords && keywords.length > 0 && (
            <ul class="project__keywords project__keywords--desktop" aria-label="Avainsanat">
              {keywords.map((kw: string) => (
                <li class="project__keyword">{kw}</li>
              ))}
            </ul>
          )}
          {projectUrl && (
            <a
              href={projectUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn--primary project__btn--desktop"
            >
              <span class="btn__text">{urlLabel}</span>
              <img src="/images/arrow.svg" class="btn__arrow" alt="" aria-hidden="true" width="27" height="15" />
            </a>
          )}
        </div>

        <!-- ── OIKEA: teksti + painike (mobiili) ────────── -->
        <div class="project__content">
          <h1 class="project__title">{title}</h1>
          <p class="project__year">{year}</p>

          {keywords && keywords.length > 0 && (
            <ul class="project__keywords project__keywords--mobile" aria-label="Avainsanat">
              {keywords.map((kw: string) => (
                <li class="project__keyword">{kw}</li>
              ))}
            </ul>
          )}

          <p class="project__ingress">{ingress}</p>

          <div class="project__body">
            <Content />
          </div>

          {projectUrl && (
            <a
              href={projectUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn--primary project__btn--mobile"
            >
              <span class="btn__text">{urlLabel}</span>
              <img src="/images/arrow.svg" class="btn__arrow" alt="" aria-hidden="true" width="27" height="15" />
            </a>
          )}
        </div>

      </div>
    </article>
  </main>

  <SiteFooter />
</BaseLayout>
